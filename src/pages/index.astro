---
import BaseLayout from '@layouts/BaseLayout.astro';
import RoomHero from '@components/RoomHero.astro';
import { profile, experience, projects, capabilities } from '@data/profile';
---

<BaseLayout>
  <RoomHero />

  <!-- About -->
  <section class="relative border-b-[3px] border-ink bg-wall-deep px-5 py-16 sm:px-8 md:px-12 lg:py-20" id="about">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.35em] text-lemon">In the room</p>
        <h2 class="section-title mt-3 text-paper">Quiet craft.<br />Clear leadership.</h2>
      </div>
      <div>
        <p class="max-w-2xl text-lg font-semibold leading-relaxed text-paper/95 md:text-xl">
          {profile.summary}
        </p>
        <p class="mt-6 max-w-xl text-base font-semibold text-lemon">
          {profile.availability}
        </p>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="relative border-b-[3px] border-ink bg-paper px-5 py-16 sm:px-8 md:px-12 lg:py-20" id="experience">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-bold uppercase tracking-[0.35em] text-wall-deep">Along the wall</p>
      <h2 class="section-title mt-3">Experience</h2>
      <ol class="mt-10 divide-y-[3px] divide-ink border-y-[3px] border-ink">
        {
          experience.map((item) => (
            <li class="grid gap-3 py-8 md:grid-cols-[10rem_1fr] md:gap-8">
              <p class="font-display text-lg font-semibold text-floor">{item.period}</p>
              <div>
                <h3 class="font-display text-2xl font-semibold text-ink">{item.title}</h3>
                <p class="mt-1 text-sm font-bold uppercase tracking-[0.2em] text-wall-deep">{item.company}</p>
                <p class="mt-3 max-w-2xl text-base font-semibold leading-relaxed text-ink/80">{item.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Selected work -->
  <section class="relative border-b-[3px] border-ink bg-wall px-5 py-16 sm:px-8 md:px-12 lg:py-20" id="work">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.35em] text-paper/80">On the table</p>
          <h2 class="section-title mt-3 text-paper">Selected work</h2>
        </div>
        <!-- Small decorative tabletop shapes -->
        <div class="flex items-center gap-2" aria-hidden="true">
          <span class="h-8 w-8 rounded-full bg-blush ink-border"></span>
          <span class="h-6 w-10 bg-lemon ink-border"></span>
          <span class="h-10 w-4 bg-sky ink-border"></span>
        </div>
      </div>
      <ul class="mt-10 divide-y-[3px] divide-ink border-y-[3px] border-ink bg-paper/15">
        {
          projects.map((project) => (
            <li class="py-7 sm:py-8">
              <div class="flex flex-wrap items-baseline gap-3">
                <span class="inline-block border-[3px] border-ink bg-lemon px-2 py-0.5 font-display text-sm font-bold text-ink">
                  {project.year}
                </span>
                <h3 class="font-display text-xl font-semibold text-paper sm:text-2xl">{project.name}</h3>
              </div>
              <p class="mt-3 max-w-3xl text-base font-semibold leading-relaxed text-paper/90">{project.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="relative border-b-[3px] border-ink bg-blush px-5 py-16 sm:px-8 md:px-12 lg:py-20" id="capabilities">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-bold uppercase tracking-[0.35em] text-ink/70">What I bring</p>
      <h2 class="section-title mt-3">Ways of working</h2>
      <p class="mt-4 max-w-2xl text-base font-semibold leading-relaxed text-ink/80 md:text-lg">
        From shaping product strategy to establishing engineering rituals—helping teams move faster without losing care for the people using the software.
      </p>
      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3">
        {
          capabilities.map((item) => (
            <li class="border-b-[3px] border-ink pb-1 font-display text-lg font-semibold text-ink md:text-xl">{item}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Contact / floor -->
  <footer class="relative bg-floor px-5 py-16 sm:px-8 md:px-12 lg:py-20" id="contact">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.35em] text-lemon">Goodnight, then hello</p>
        <h2
          class="mt-3 font-display text-4xl font-semibold leading-tight text-paper md:text-5xl"
          style="text-shadow: 3px 3px 0 #1A1A1A;"
        >
          Let’s build something<br />worth staying up for.
        </h2>
        <p class="mt-4 font-semibold text-paper/90">{profile.location}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="cta-primary" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="cta-secondary" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </div>
    <p class="mx-auto mt-12 max-w-6xl text-xs font-bold uppercase tracking-[0.25em] text-paper/60">
      © {new Date().getFullYear()} {profile.name}
    </p>
  </footer>
</BaseLayout>
