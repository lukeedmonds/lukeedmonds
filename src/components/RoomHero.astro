---
import { profile } from '@data/profile';
---

<section
  class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-wall"
  aria-label="Introduction"
>
  <!-- Wall texture: subtle vertical stripes without looking cardy -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    style="background-image: repeating-linear-gradient(90deg, #1A1A1A 0 1px, transparent 1px 48px);"
    aria-hidden="true"
  >
  </div>

  <!-- Floating balloon (original shape, not book character) -->
  <div
    class="pointer-events-none absolute right-[8%] top-[10%] z-20 hidden animate-float sm:block"
    aria-hidden="true"
  >
    <svg width="56" height="96" viewBox="0 0 56 96" fill="none">
      <ellipse cx="28" cy="28" rx="22" ry="26" fill="#C62828" stroke="#1A1A1A" stroke-width="3"></ellipse>
      <path d="M28 54 C28 54 22 62 28 70 C34 62 28 54 28 54" fill="#C62828" stroke="#1A1A1A" stroke-width="2"></path>
      <path d="M28 70 Q24 82 30 94" stroke="#1A1A1A" stroke-width="2" fill="none" stroke-linecap="round"></path>
      <ellipse cx="20" cy="20" rx="5" ry="8" fill="#FFF8E7" opacity="0.35"></ellipse>
    </svg>
  </div>

  <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-1 flex-col px-5 pb-0 pt-5 sm:px-8 sm:pt-8 md:px-12 md:pt-10">
    <p class="font-sans text-xs font-bold uppercase tracking-[0.35em] text-paper/90">
      {profile.location}
    </p>

    <div class="mt-4 grid flex-1 items-end gap-5 sm:mt-6 sm:gap-8 lg:mt-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-12">
      <!-- Brand + copy -->
      <div class="relative z-10 max-w-xl pb-2 lg:pb-16">
        <h1
          class="font-display text-[clamp(2.75rem,11vw,6.5rem)] font-semibold leading-[0.92] tracking-tight text-paper"
          style="text-shadow: 3px 3px 0 #1A1A1A;"
        >
          {profile.name}
        </h1>
        <p class="mt-3 font-display text-lg font-medium text-lemon sm:mt-4 sm:text-xl md:text-2xl">
          {profile.role}
        </p>
        <p class="mt-3 max-w-md text-sm font-semibold leading-relaxed text-paper/95 sm:mt-4 sm:text-base md:text-lg">
          {profile.tagline}
        </p>
        <div class="mt-5 flex flex-wrap gap-3 sm:mt-8">
          <a class="cta-primary" href={`mailto:${profile.email}`}>Say hello</a>
          <a class="cta-secondary" href={profile.linkedin} target="_blank" rel="noreferrer">
            LinkedIn
          </a>
        </div>
      </div>

      <!-- Night window — dominant visual plane -->
      <div class="relative mx-auto w-full max-w-md lg:mx-0 lg:max-w-none lg:justify-self-end">
        <div class="relative ink-border bg-sky shadow-[6px_6px_0_#1A1A1A]">
          <!-- Curtain strip -->
          <div
            class="absolute -left-1 top-0 z-10 h-full w-7 origin-top animate-sway bg-[repeating-linear-gradient(180deg,#F4D35E_0_10px,#C62828_10px_20px)] sm:w-9"
            aria-hidden="true"
          >
          </div>
          <div class="relative aspect-[5/4] overflow-hidden bg-sky sm:aspect-[4/5] lg:aspect-[5/6]">
            <!-- Stars -->
            <div class="absolute inset-0" aria-hidden="true">
              {
                [
                  [12, 18, 1],
                  [28, 12, 1.4],
                  [48, 22, 1],
                  [68, 14, 1.2],
                  [82, 28, 1],
                  [18, 42, 1.1],
                  [40, 38, 0.9],
                  [58, 48, 1.3],
                  [78, 44, 1],
                  [22, 62, 1.2],
                  [45, 70, 1],
                  [70, 66, 1.1],
                  [88, 58, 0.9],
                  [35, 52, 1],
                  [55, 30, 1.2]
                ].map(([left, top, delay], i) => (
                  <span
                    class="absolute block h-1.5 w-1.5 rounded-sm bg-paper animate-twinkle"
                    style={`left:${left}%; top:${top}%; animation-delay:${(delay as number) * i * 0.12}s;`}
                  />
                ))
              }
            </div>
            <!-- Crescent moon -->
            <div
              class="absolute right-[14%] top-[12%] h-16 w-16 animate-pulse-glow sm:h-20 sm:w-20"
              aria-hidden="true"
            >
              <svg viewBox="0 0 80 80" class="h-full w-full">
                <circle cx="40" cy="40" r="28" fill="#F7F1C8" stroke="#1A1A1A" stroke-width="3"></circle>
                <circle cx="52" cy="34" r="22" fill="#15224B"></circle>
              </svg>
            </div>
            <!-- Window muntins -->
            <div class="pointer-events-none absolute inset-0 grid grid-cols-2 grid-rows-2" aria-hidden="true">
              <div class="border-b-[3px] border-r-[3px] border-ink/80"></div>
              <div class="border-b-[3px] border-ink/80"></div>
              <div class="border-r-[3px] border-ink/80"></div>
              <div></div>
            </div>
          </div>
          <!-- Yellow sill / lamp table -->
          <div class="relative flex items-end justify-between gap-3 border-t-[3px] border-ink bg-lemon px-4 py-3">
            <div class="flex items-end gap-3" aria-hidden="true">
              <!-- Lamp -->
              <svg width="42" height="54" viewBox="0 0 42 54" class="animate-pulse-glow drop-shadow-[0_0_10px_rgba(240,138,36,0.7)]">
                <path d="M8 22 L21 4 L34 22 Z" fill="#F08A24" stroke="#1A1A1A" stroke-width="2.5"></path>
                <rect x="19" y="22" width="4" height="18" fill="#1A1A1A"></rect>
                <ellipse cx="21" cy="42" rx="12" ry="4" fill="#2F8F45" stroke="#1A1A1A" stroke-width="2"></ellipse>
                <ellipse cx="21" cy="14" rx="6" ry="3" fill="#F7F1C8" opacity="0.7"></ellipse>
              </svg>
              <span class="mb-1 hidden text-xs font-bold uppercase tracking-[0.2em] text-ink/70 sm:inline">
                Good evening
              </span>
            </div>
            <span class="font-display text-sm font-semibold text-ink">{new Date().getFullYear()}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tomato floor -->
  <div class="relative z-10 mt-auto border-t-[3px] border-ink bg-floor">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8 md:px-12">
      <div class="h-3 w-24 rounded-full bg-blush ink-border sm:w-36" aria-hidden="true"></div>
      <p class="text-xs font-bold uppercase tracking-[0.25em] text-paper/90 sm:text-sm">
        Scroll the room
      </p>
      <div class="h-3 w-16 rounded-full bg-lemon ink-border sm:w-24" aria-hidden="true"></div>
    </div>
  </div>
</section>
